         /// <summary>
+        /// Whether the agent may use the call channel (an IM session id): a group's call (the session id is the
+        /// group id; the agent must be a member) or a P2P call (the session id is the two agents' ids XORed, so XORed
+        /// with the agent's own id it must give another avatar: a third person who computes A^B gets nothing).
+        /// </summary>
+        private static bool MayUseCallChannel(Scene scene, UUID agentID, UUID channelID, out string name)
+        {
+            IGroupsModule groups = scene.RequestModuleInterface<IGroupsModule>();
+            GroupMembershipData membership = groups?.GetMembershipData(channelID, agentID);
+            if (membership is not null)
+            {
+                name = membership.GroupName;
+                return true;
+            }
+
+            UUID otherID = new(channelID.ulonga ^ agentID.ulonga, channelID.ulongb ^ agentID.ulongb);
+            name = otherID.ToString();
+            if (otherID.IsZero() || otherID.Equals(agentID))
+                return false;
+
+            foreach (Scene s in SceneManager.Instance.Scenes)
+            {
+                if (s.TryGetScenePresence(otherID, out ScenePresence other) && !other.IsNPC)
+                {
+                    name = other.Name;
+                    return true;
+                }
+            }
+            var account = scene.UserAccountService?.GetUserAccount(scene.RegionInfo.ScopeID, otherID);
+            if (account is null)
+                return false;
+            name = account.Name;
+            return true;
+        }
+
+        private static bool IsGroupSession(Scene scene, UUID sessionID)
+        {
+            IGroupsModule groups = scene.RequestModuleInterface<IGroupsModule>();
+            return groups?.GetGroupRecord(sessionID) is not null;
+        }
+
+        /// <summary>Whether the agent has a live voice session for this call channel (on this simulator).</summary>
+        private static bool IsInCall(UUID channelID, UUID agentID)
+        {
+            foreach (KeyValuePair<string, UUID> entry in m_callChannels)
+            {
+                if (!VoiceViewerSession.TryGetViewerSession(entry.Key, out IVoiceViewerSession session))
+                {
+                    m_callChannels.TryRemove(entry.Key, out _);
+                    continue;
+                }
+                if (entry.Value.Equals(channelID) && session.AgentId.Equals(agentID))
+                    return true;
+            }
+            return false;
+        }
+
+        /// <summary>A call's voice channel as the viewer takes it ("voice_credentials", or a voice invitation's "voice").</summary>
+        private static OSDMap CallChannelInfo(UUID sessionID, int? invitationType)
+        {
+            OSDMap info = new()
+            {
+                { "channel_uri", sessionID.ToString() },
+                { "channel_credentials", string.Empty },
+                { "voice_server_type", "webrtc" }
+            };
+            if (invitationType.HasValue)
+                info["invitation_type"] = invitationType.Value;
+            return info;
+        }
+
+        /// <summary>
+        /// Rings the other party of a P2P call: a ChatterBoxInvitation carrying the voice channel, which the viewer
+        /// shows as an incoming call and joins on accepting. Only for callees on this simulator; others are not rung
+        /// (they would need the invitation passed on through the grid, e.g. as an instant message turned back into
+        /// this event by the callee's simulator).
+        /// </summary>
+        private static void RingP2PCallee(ScenePresence caller, UUID calleeID, UUID sessionID)
+        {
+            foreach (Scene s in SceneManager.Instance.Scenes)
+            {
+                if (s.TryGetScenePresence(calleeID, out ScenePresence callee) && !callee.IsChildAgent && !callee.IsNPC)
+                {
+                    OSDMap invitation = new()
+                    {
+                        { "message", "ChatterBoxInvitation" },
+                        { "body", new OSDMap
+                            {
+                                { "session_id", sessionID },
+                                { "session_name", caller.Name },
+                                { "from_id", caller.UUID },
+                                { "from_name", caller.Name },
+                                { "voice", CallChannelInfo(sessionID, P2P_CHAT_SESSION) }
+                            }
+                        }
+                    };
+                    s.RequestModuleInterface<IEventQueue>()?.Enqueue((OSD)invitation, calleeID);
+                    return;
+                }
+            }
+            m_log.Debug($"{LogHeader} P2P call from {caller.Name} to {calleeID}: callee not on this simulator, not rung");
+        }
