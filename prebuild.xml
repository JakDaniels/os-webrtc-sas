<?xml version="1.0" ?>
<!-- Included by OpenSim's prebuild.xml (addon-modules/*/prebuild*.xml). Builds bin/WebRtcSas.dll. -->
<Project name="WebRtcSas" path="addon-modules/os-webrtc-sas/WebRtcSas" type="Library">
  <Configuration name="Debug">
    <Options>
      <OutputPath>../../../bin/</OutputPath>
    </Options>
  </Configuration>
  <Configuration name="Release">
    <Options>
      <OutputPath>../../../bin/</OutputPath>
    </Options>
  </Configuration>

  <ReferencePath>../../../bin/</ReferencePath>
  <Reference name="OpenSim.Framework"/>
  <Reference name="OpenSim.Framework.Console"/>
  <Reference name="OpenSim.Region.Framework"/>
  <Reference name="OpenSim.Server.Base"/>
  <Reference name="OpenSim.Services.Interfaces"/>

  <Reference name="OpenMetaverse"/>
  <Reference name="OpenMetaverseTypes"/>
  <Reference name="OpenMetaverse.StructuredData"/>

  <!-- OpenSim's WebRTC voice interfaces (OpenSim/Addons/os-webrtc-janus/WebRtcVoice) -->
  <Reference name="WebRtcVoice"/>

  <Reference name="Nini"/>
  <Reference name="log4net"/>

  <Files>
    <Match pattern="*.cs" recurse="true">
      <Exclude name="Tests" pattern="Tests"/>
      <Exclude name="Object" pattern="obj"/>
    </Match>
  </Files>
</Project>
